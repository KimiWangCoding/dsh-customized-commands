{
  "name": "@kimiwangcoding/dsh-customized-commands",
  "version": "1.0.0",
  "description": "User-defined /xxx slash commands for DeepSeek Harness that expand into full prompts on Enter.",
  "license": "MIT",
  "author": "KimiWangCoding",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "slash-commands"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/all.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  }
}
